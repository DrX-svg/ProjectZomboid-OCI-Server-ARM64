#!/usr/bin/env python3
import json
import socket
import struct
import subprocess
import re
from datetime import datetime, timezone

CONTAINER = "pz-server-fex"
HOST = "127.0.0.1"
PORT = 27015

def run(*args, timeout=8):
    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL, timeout=timeout).strip()

def docker_bash(command, timeout=8):
    return run("docker", "exec", CONTAINER, "bash", "-lc", command, timeout=timeout)

def packet(req_id, pkt_type, text):
    body = text.encode("utf-8") + b"\x00\x00"
    return struct.pack("<iii", len(body) + 8, req_id, pkt_type) + body

def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("RCON connection closed")
        data += chunk
    return data

def recv_packet(sock):
    size = struct.unpack("<i", recv_exact(sock, 4))[0]
    data = recv_exact(sock, size)
    req_id, pkt_type = struct.unpack("<ii", data[:8])
    text = data[8:-2].decode("utf-8", errors="replace")
    return req_id, pkt_type, text

def rcon(command, password):
    with socket.create_connection((HOST, PORT), timeout=4) as sock:
        sock.settimeout(4)
        sock.sendall(packet(1, 3, password))

        authenticated = False
        for _ in range(3):
            req_id, pkt_type, text = recv_packet(sock)
            if req_id == -1:
                raise PermissionError("RCON authentication failed")
            if req_id == 1 and pkt_type == 2:
                authenticated = True
                break

        if not authenticated:
            raise ConnectionError("No RCON authentication response")

        sock.sendall(packet(2, 2, command))
        req_id, pkt_type, text = recv_packet(sock)
        return text

def parse_players(text):
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    count = None
    names = []

    for line in lines:
        m = re.search(r"Players connected\s*\((\d+)\)", line, re.I)
        if m:
            count = int(m.group(1))
            continue

        if line.lower().startswith("players connected"):
            continue

        name = re.sub(r"^[\-\*\u2022]\s*", "", line).strip()
        if name:
            names.append(name)

    if count is None:
        count = len(names)

    if count == 0:
        names = []

    return count, names

def connection_times(active_names):
    if not active_names:
        return {}

    list_cmd = (
        'find /home/steam/Zomboid/Logs -type f -name "*_connections.txt" '
        '-printf "%T@ %p\\n" 2>/dev/null | sort -n | tail -50 | cut -d" " -f2-'
    )

    files = docker_bash(list_cmd, timeout=10).splitlines()
    if not files:
        return {}

    quoted = []
    for path in files:
        quoted.append("'" + path.replace("'", "'\\''") + "'")

    content = docker_bash("cat " + " ".join(quoted), timeout=12)

    latest = {}
    active = set(active_names)

    for line in content.splitlines():
        if 'event="fully-connected"' not in line:
            continue

        user_match = re.search(r'username="([^"]+)"', line)
        if not user_match:
            continue

        username = user_match.group(1)
        if username not in active:
            continue

        time_match = re.match(r'\[(\d{2}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+)\]', line)
        if not time_match:
            continue

        try:
            dt = datetime.strptime(time_match.group(1), "%d-%m-%y %H:%M:%S.%f")
            dt = dt.replace(tzinfo=timezone.utc)
        except ValueError:
            continue

        latest[username] = int(dt.timestamp())

    return latest

result = {
    "rcon_ok": False,
    "count": 0,
    "max_players": 32,
    "players": [],
}

try:
    running = run("docker", "inspect", "-f", "{{.State.Running}}", CONTAINER)
    if running != "true":
        print(json.dumps(result))
        raise SystemExit(0)

    max_players = docker_bash(
        'grep -m1 "^MaxPlayers=" /home/steam/Zomboid/Server/servertest.ini | cut -d= -f2-'
    )
    if max_players.isdigit():
        result["max_players"] = int(max_players)

    password = docker_bash(
        'grep -m1 "^RCONPassword=" /home/steam/Zomboid/Server/servertest.ini | cut -d= -f2-'
    )
    if not password:
        raise RuntimeError("RCON password missing")

    response = rcon("players", password)
    count, names = parse_players(response)
    times = connection_times(names)

    now = int(datetime.now(timezone.utc).timestamp())
    players = []
    for name in names:
        connected = times.get(name)
        players.append({
            "name": name,
            "connected_epoch": connected,
            "online_seconds": max(0, now - connected) if connected else None,
        })

    result.update({
        "rcon_ok": True,
        "count": count,
        "players": players,
    })

except Exception as exc:
    result["error"] = type(exc).__name__

print(json.dumps(result, ensure_ascii=False))
